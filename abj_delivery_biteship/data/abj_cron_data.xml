<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ════════════════════════════════════════════════════════════════════
         CRON: Biteship Tracking Status Update (Fallback)
         Webhook is the primary source of truth. This cron runs as backup.
         ════════════════════════════════════════════════════════════════════ -->
    <record id="abj_cron_biteship_tracking" model="ir.cron">
        <field name="name">Biteship: Update Tracking Status (Fallback)</field>
        <field name="model_id" ref="stock.model_stock_picking"/>
        <field name="state">code</field>
        <field name="code">model._abj_cron_update_biteship_tracking()</field>
        <field name="interval_number">30</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>

</odoo>
