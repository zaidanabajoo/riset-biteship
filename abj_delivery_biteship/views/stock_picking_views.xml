<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ════════════════════════════════════════════════════════════════════
         STOCK PICKING – Inherit Form View (Biteship Shipment & Tracking)
         ════════════════════════════════════════════════════════════════════ -->
    <record id="abj_stock_picking_view_form" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.abj.biteship</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">

            <!-- ── Buttons di header ── -->
            <xpath expr="//header" position="inside">
                <button name="action_abj_create_biteship_shipment"
                        string="📦 Create Shipment &amp; Request Pickup"
                        type="object"
                        class="btn-primary"
                        invisible="state not in ('assigned', 'done') or abj_shipment_id"
                        confirm="Membuat order pengiriman di Biteship dan trigger pickup. Lanjutkan?"
                        groups="stock.group_stock_user"/>
                <button name="action_abj_refresh_biteship_status"
                        string="🔄 Refresh Status"
                        type="object"
                        class="btn-secondary"
                        invisible="not abj_shipment_id"
                        groups="stock.group_stock_user"/>
            </xpath>

            <!-- ── Notebook Page: Info Pengiriman Biteship ── -->
            <xpath expr="//page[@name='extra']" position="after">
                <page string="📦 Pengiriman (Biteship)" name="abj_biteship_info">
                    <group>
                        <group string="Informasi Resi &amp; Tracking">
                            <field name="abj_tracking_number"/>
                            <field name="carrier_tracking_ref" string="Tracking Ref"/>
                            <field name="abj_biteship_tracking_id" readonly="1"
                                   string="Biteship Tracking ID"/>
                        </group>
                        <group string="Order Biteship">
                            <field name="abj_shipment_id" readonly="1"/>
                            <field name="abj_courier_name" readonly="1"/>
                            <field name="abj_service_type" readonly="1"/>
                            <field name="abj_shipping_cost" readonly="1"
                                   widget="monetary"/>
                            <field name="abj_pickup_status" readonly="1"
                                   widget="badge"
                                   decoration-info="abj_pickup_status == 'draft'"
                                   decoration-warning="abj_pickup_status in ('confirmed', 'allocated', 'picking_up', 'on_hold')"
                                   decoration-success="abj_pickup_status in ('picked', 'dropping_off', 'delivered')"
                                   decoration-danger="abj_pickup_status in ('rejected', 'cancelled', 'returned', 'courier_not_found')"/>
                        </group>
                    </group>

                    <group>
                        <group string="Pengaturan">
                            <field name="abj_delivery_type_mode"
                                   invisible="abj_shipment_id"/>
                            <field name="abj_delivery_status" readonly="1"
                                   string="Status Mentah"/>
                        </group>
                        <group string="Aksi Cepat">
                            <div>
                                <button name="action_abj_track_biteship_shipment"
                                        string="🔍 Lacak Paket"
                                        type="object"
                                        class="btn-link"
                                        invisible="not abj_tracking_number"/>
                            </div>
                        </group>
                    </group>
                </page>
            </xpath>

        </field>
    </record>

    <!-- ════════════════════════════════════════════════════════════════════
         STOCK PICKING – Inherit List View (tambah kolom Resi & Status)
         ════════════════════════════════════════════════════════════════════ -->
    <record id="abj_stock_picking_view_list" model="ir.ui.view">
        <field name="name">stock.picking.list.inherit.abj.biteship</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.vpicktree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="before">
                <field name="abj_tracking_number" string="Resi" optional="show"/>
                <field name="abj_pickup_status" string="Status Biteship"
                       widget="badge"
                       decoration-info="abj_pickup_status == 'draft'"
                       decoration-warning="abj_pickup_status in ('confirmed', 'allocated', 'picking_up')"
                       decoration-success="abj_pickup_status in ('picked', 'dropping_off', 'delivered')"
                       decoration-danger="abj_pickup_status in ('rejected', 'cancelled', 'returned')"
                       optional="show"/>
            </xpath>
        </field>
    </record>

</odoo>
