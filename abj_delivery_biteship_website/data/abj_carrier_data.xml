        <record id="abj_carrier_jne_reg" model="delivery.carrier">
            <field name="name">Biteship JNE Reguler</field>
            <field name="delivery_type">abj_biteship</field>
            <field name="product_id" ref="delivery.product_product_delivery"/>
            <field name="abj_biteship_courier_code">jne</field>
            <field name="abj_biteship_service_type">jne__reg</field>
            <field name="website_published" eval="True"/>
